  <script>
    document.getElementById("year").textContent = new Date().getFullYear();

    // TODO: Paste your Google Apps Script Web App URL here
    // Example: const SCRIPT_URL = "https://script.google.com/macros/s/ABC123.../exec";
    const SCRIPT_URL = "https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec";

    const form = document.getElementById("registration-form");
    const statusElement = document.getElementById("form-status");

    async function handleSubmit(event) {
      event.preventDefault();
      statusElement.textContent = "";
      statusElement.className = "status-message";

      // Simple guard: check if SCRIPT_URL was updated
      if (!SCRIPT_URL || SCRIPT_URL.includes("YOUR_SCRIPT_ID")) {
        statusElement.textContent =
          "Form is not yet connected to Google Sheets. Please contact the site owner.";
        statusElement.classList.add("status-error");
        return;
      }

      const formData = new FormData(form);

      // NOTE ABOUT FILES:
      // FormData will include the file inputs (titleFront, titleBack, idPicture).
      // On the Apps Script side, you'll need to read the file blobs from the request
      // and either:
      //  - Save them to Google Drive and store the Drive URL in the Sheet, or
      //  - Store base64 or other reference.
      //
      // This code sends everything as multipart/form-data, which Apps Script can read.

      try {
        statusElement.textContent = "Submitting your information...";
        const response = await fetch(SCRIPT_URL, {
          method: "POST",
          body: formData,
        });

        if (!response.ok) {
          throw new Error("Network response was not ok");
        }

        const resultText = await response.text();

        // You can have Apps Script respond with JSON and parse it here if you like:
        // const result = await response.json();

        statusElement.textContent = "Thank you! Your information has been submitted.";
        statusElement.classList.add("status-success");
        form.reset();
      } catch (error) {
        console.error(error);
        statusElement.textContent =
          "Something went wrong submitting the form. Please try again or contact us.";
        statusElement.classList.add("status-error");
      }
    }

    form.addEventListener("submit", handleSubmit);
  </script>
