<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Coming Soon | Your Brand</title>
  <meta name="description" content="We are crafting a premium new website. Stay tuned and contact us in the meantime." />
  <meta property="og:title" content="Coming Soon | Your Brand" />
  <meta property="og:description" content="We are crafting a premium new website. Stay tuned and contact us in the meantime." />
  <meta property="og:image" content="https://yourdomain.com/og-image.jpg" />
  <meta property="og:url" content="https://yourdomain.com" />
  <meta name="twitter:card" content="summary_large_image" />
  <style>
    :root {
      /* === Edit background colors here === */
      --bg-gradient: radial-gradient(circle at 20% 20%, #dbeafe 0%, rgba(99, 102, 241, 0.25) 25%, transparent 45%),
        radial-gradient(circle at 80% 0%, rgba(244, 114, 182, 0.3) 0%, transparent 35%),
        linear-gradient(135deg, #0b1021, #0f172a 50%, #0b1227);
      --card-bg: rgba(15, 23, 42, 0.8);
      --card-border: rgba(255, 255, 255, 0.08);
      --accent: #7c3aed;
      --accent-strong: #8b5cf6;
      --text-main: #f8fafc;
      --text-muted: #cbd5e1;
      --shadow: 0 20px 70px rgba(0, 0, 0, 0.35);
      --success: #22c55e;
      --error: #f43f5e;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: var(--bg-gradient);
      color: var(--text-main);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px 14px 40px;
    }

    main {
      width: min(100%, 960px);
    }

    .card {
      position: relative;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 22px;
      padding: clamp(22px, 4vw, 38px);
      box-shadow: var(--shadow);
      overflow: hidden;
      backdrop-filter: blur(12px);
      isolation: isolate;
    }

    .card::before,
    .card::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      opacity: 0.9;
      filter: blur(100px);
      transform: scale(1.1);
    }

    .card::before {
      background: radial-gradient(circle at 20% 20%, rgba(124, 58, 237, 0.25), transparent 50%);
    }

    .card::after {
      background: radial-gradient(circle at 80% 0%, rgba(56, 189, 248, 0.25), transparent 50%);
      mix-blend-mode: screen;
    }

    .content {
      position: relative;
      z-index: 1;
      display: grid;
      gap: 28px;
    }

    header {
      display: grid;
      gap: 14px;
      text-align: center;
    }

    .brand {
      font-weight: 700;
      letter-spacing: 0.04em;
      font-size: 14px;
      text-transform: uppercase;
      color: var(--text-muted);
    }

    .hero-title {
      font-size: clamp(28px, 6vw, 36px);
      margin: 0;
      line-height: 1.2;
    }

    .hero-subtitle {
      margin: 6px 0 0;
      color: var(--text-muted);
      font-size: 16px;
      line-height: 1.6;
    }

    .cta-row {
      display: flex;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 6px;
    }

    .btn {
      appearance: none;
      border: 1px solid transparent;
      border-radius: 999px;
      padding: 12px 18px;
      font-weight: 600;
      font-size: 15px;
      cursor: pointer;
      transition: transform 180ms ease, box-shadow 180ms ease, border 180ms ease;
      color: #0b1021;
      background: linear-gradient(135deg, var(--accent), var(--accent-strong));
      box-shadow: 0 12px 35px rgba(124, 58, 237, 0.35);
    }

    .btn:focus-visible {
      outline: 2px solid #a78bfa;
      outline-offset: 3px;
    }

    .btn:hover {
      transform: translateY(-1px) scale(1.01);
      box-shadow: 0 18px 45px rgba(124, 58, 237, 0.4);
    }

    .section-card {
      border: 1px solid var(--card-border);
      border-radius: 16px;
      padding: 16px;
      background: rgba(255, 255, 255, 0.02);
    }

    .mini-label {
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-size: 11px;
      color: var(--text-muted);
      margin-bottom: 6px;
      display: inline-block;
    }

    .countdown {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      gap: 12px;
      margin-top: 8px;
    }

    .count-box {
      padding: 14px;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(255, 255, 255, 0.02);
      text-align: center;
    }

    .count-number {
      font-size: 26px;
      font-weight: 700;
      margin-bottom: 4px;
    }

    .contact-section {
      display: grid;
      gap: 16px;
    }

    .contact-links {
      display: grid;
      gap: 8px;
      font-size: 15px;
    }

    .contact-links a {
      color: var(--text-main);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 12px;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      transition: border 150ms ease, transform 150ms ease;
    }

    .contact-links a:hover,
    .contact-links a:focus-visible {
      border-color: rgba(255, 255, 255, 0.2);
      transform: translateY(-1px);
      outline: none;
    }

    .contact-form {
      display: grid;
      gap: 10px;
    }

    label {
      font-size: 14px;
      color: var(--text-muted);
    }

    input,
    textarea {
      width: 100%;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.16);
      background: rgba(255, 255, 255, 0.04);
      color: var(--text-main);
      padding: 12px;
      font-size: 15px;
      transition: border 150ms ease, box-shadow 150ms ease;
    }

    input:focus-visible,
    textarea:focus-visible {
      outline: none;
      border-color: rgba(124, 58, 237, 0.65);
      box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.2);
    }

    .form-row {
      display: grid;
      gap: 10px;
    }

    .success-msg,
    .error-msg {
      margin: 6px 0 0;
      font-size: 14px;
    }

    .success-msg {
      color: var(--success);
    }

    .error-msg {
      color: var(--error);
    }

    .social-row {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      align-items: center;
      margin-top: 4px;
    }

    .social-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 42px;
      height: 42px;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.03);
      transition: transform 150ms ease, border 150ms ease;
      color: var(--text-main);
    }

    .social-link:hover,
    .social-link:focus-visible {
      transform: translateY(-1px) scale(1.02);
      border-color: rgba(255, 255, 255, 0.22);
      outline: none;
    }

    footer {
      text-align: center;
      margin-top: 6px;
      color: var(--text-muted);
      font-size: 13px;
    }

    @media (min-width: 820px) {
      .content {
        grid-template-columns: 1.1fr 1fr;
        align-items: start;
      }

      header {
        text-align: left;
      }

      .cta-row {
        justify-content: flex-start;
      }
    }
  </style>
</head>
<body>
  <main>
    <section class="card" aria-label="Coming soon announcement">
      <div class="content">
        <header>
          <div class="brand" aria-label="Brand name">Your Brand</div>
          <h1 class="hero-title">We’re building something awesome.</h1>
          <p class="hero-subtitle">Our new website is coming soon. Stay tuned!</p>
          <div class="cta-row">
            <button class="btn" id="contactBtn" type="button">Contact Us</button>
          </div>
          <p class="mini-label" aria-live="polite">In the meantime, contact us:</p>
          <div class="social-row" aria-label="Social links">
            <!-- Edit social URLs below -->
            <a class="social-link" href="https://instagram.com/yourbrand" aria-label="Instagram" target="_blank" rel="noreferrer noopener">
              <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.5" y2="6.5"></line>
              </svg>
            </a>
            <a class="social-link" href="https://facebook.com/yourbrand" aria-label="Facebook" target="_blank" rel="noreferrer noopener">
              <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3.5l.5-4H14V7a1 1 0 0 1 1-1h3z"></path>
              </svg>
            </a>
          </div>
        </header>

        <div class="section-card" id="countdownSection" aria-live="polite">
          <span class="mini-label">Countdown</span>
          <div class="countdown" role="group" aria-label="Countdown timer">
            <div class="count-box" aria-label="Days remaining">
              <div class="count-number" id="days">--</div>
              <div class="count-label">Days</div>
            </div>
            <div class="count-box" aria-label="Hours remaining">
              <div class="count-number" id="hours">--</div>
              <div class="count-label">Hours</div>
            </div>
            <div class="count-box" aria-label="Minutes remaining">
              <div class="count-number" id="minutes">--</div>
              <div class="count-label">Minutes</div>
            </div>
            <div class="count-box" aria-label="Seconds remaining">
              <div class="count-number" id="seconds">--</div>
              <div class="count-label">Seconds</div>
            </div>
          </div>
        </div>

        <div class="section-card contact-section" id="contact" aria-label="Contact options">
          <div>
            <span class="mini-label">Contact</span>
            <div class="contact-links">
              <!-- === Edit contact info here === -->
              <a href="mailto:hello@yourdomain.com" aria-label="Email hello at your domain">hello@yourdomain.com</a>
              <a href="tel:+18889814798" aria-label="Call us at +1 888 981 4798">+1 (888) 981-4798</a>
            </div>
          </div>

          <div aria-label="Contact form">
            <span class="mini-label">Send a note</span>
            <form class="contact-form" id="contactForm" novalidate>
              <div class="form-row">
                <label for="name">Name *</label>
                <input id="name" name="name" required placeholder="Your name" />
              </div>
              <div class="form-row">
                <label for="email">Email *</label>
                <input id="email" name="email" type="email" required placeholder="you@example.com" />
              </div>
              <div class="form-row">
                <label for="message">Message *</label>
                <textarea id="message" name="message" rows="3" required placeholder="How can we help?"></textarea>
              </div>
              <button class="btn" type="submit">Send Message</button>
              <p class="success-msg" id="successMsg" role="status" aria-live="polite" hidden>Message sent. We will be in touch soon.</p>
              <p class="error-msg" id="errorMsg" role="alert" hidden>Please fill in all fields with a valid email.</p>
            </form>
          </div>
        </div>
      </div>
      <footer>© <span id="year"></span> <span id="brandFooter">Your Brand</span>. All rights reserved.</footer>
    </section>
  </main>

  <script>
    // === Edit brand name below ===
    const brandName = "Your Brand";
    document.querySelector('.brand').textContent = brandName;
    document.getElementById('brandFooter').textContent = brandName;

    // === Toggle countdown on/off ===
    const SHOW_COUNTDOWN = true;

    // === Edit countdown target date here ===
    const targetDate = new Date();
    targetDate.setDate(targetDate.getDate() + 30); // Default: 30 days from now

    const countdownSection = document.getElementById('countdownSection');
    if (!SHOW_COUNTDOWN) {
      countdownSection.style.display = 'none';
    } else {
      const dayEl = document.getElementById('days');
      const hourEl = document.getElementById('hours');
      const minEl = document.getElementById('minutes');
      const secEl = document.getElementById('seconds');

      const updateCountdown = () => {
        const now = new Date().getTime();
        const distance = targetDate.getTime() - now;
        if (distance <= 0) {
          dayEl.textContent = hourEl.textContent = minEl.textContent = secEl.textContent = '00';
          return;
        }
        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        dayEl.textContent = String(days).padStart(2, '0');
        hourEl.textContent = String(hours).padStart(2, '0');
        minEl.textContent = String(minutes).padStart(2, '0');
        secEl.textContent = String(seconds).padStart(2, '0');
      };

      updateCountdown();
      setInterval(updateCountdown, 1000);
    }

    document.getElementById('year').textContent = new Date().getFullYear();

    // Smooth scroll to contact section
    document.getElementById('contactBtn').addEventListener('click', () => {
      document.getElementById('contact').scrollIntoView({ behavior: 'smooth' });
    });

    // Form validation & simulated submit
    const form = document.getElementById('contactForm');
    const successMsg = document.getElementById('successMsg');
    const errorMsg = document.getElementById('errorMsg');

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      errorMsg.hidden = true;
      successMsg.hidden = true;

      const formData = new FormData(form);
      const name = formData.get('name').trim();
      const email = formData.get('email').trim();
      const message = formData.get('message').trim();
      const emailValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);

      if (!name || !emailValid || !message) {
        errorMsg.hidden = false;
        return;
      }

      form.querySelector('button[type="submit"]').disabled = true;
      setTimeout(() => {
        successMsg.hidden = false;
        form.reset();
        form.querySelector('button[type="submit"]').disabled = false;
      }, 600);
    });
  </script>
</body>
</html>
